 *
 * Linker script of the compile-only riscv64 port (see sys/arch/riscv64).
 * The port is checked, never linked into a bootable kernel.
 */

ENTRY(_start)

SECTIONS
{
	. = 0xffffffc000200000;
	.text : { *(.text .text.*) }
	.rodata : { *(.rodata .rodata.*) }
	.data : { *(.data .data.*) }
	.bss : { *(.bss .bss.*) *(COMMON) }
}
